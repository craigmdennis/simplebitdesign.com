{
  // Cloudflare Workers static assets config for the legacy (Middleman) site.
  //
  // IMPORTANT: ./snapshot is a captured artifact, NOT a build output. The 2016
  // toolchain this repo describes (Ruby 2.3.6, Node 5.9, node-sass 3.x, gulp 3.9)
  // no longer builds, so the deployed HTML was mirrored from the running site and
  // then had Google Tag Manager swapped for Plausible to match commit 56a25b9.
  //
  // Editing source/*.haml will NOT change what deploys. If this site ever needs
  // real changes again, the toolchain has to be revived (Docker, linux/amd64)
  // or the site rebuilt on something current.
  "name": "simplebitdesign",
  "compatibility_date": "2026-08-10",

  // worker.js exists only to synthesise HTTP Range (206) responses, which the
  // ASSETS binding does not do and iOS WebKit requires before it will play the
  // header video. See the comment at the top of worker.js.
  "main": "./worker.js",

  // Keep the workers.dev URL alive as a staging target. Wrangler disables it by
  // default when the key is absent, which silently takes the staging URL down
  // the first time any other trigger is configured.
  "workers_dev": true,

  // Custom Domains: Cloudflare creates and manages the DNS records and the
  // certificate itself, replacing the Netlify A records on the apex and the
  // www CNAME. www is included deliberately — leaving it on Netlify would keep
  // serving the old GTM build to anyone using that hostname.
  "routes": [
    { "pattern": "simplebitdesign.com", "custom_domain": true },
    { "pattern": "www.simplebitdesign.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./snapshot",
    "binding": "ASSETS",
    // Without this, assets are served directly and the Worker never sees a
    // request for /video/bg.mp4 — so the range handling would never run.
    "run_worker_first": true
    // No not_found_handling: the live site has no custom 404 page, so the
    // Cloudflare default matches today's behaviour.
  }
}
